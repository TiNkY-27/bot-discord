DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Discord Activity (panel dentro del canal de voz) - opcional
ACTIVITY_ENABLED=false
ACTIVITY_PORT=3000
DISCORD_CLIENT_SECRET=

# Solo hacen falta en la nube (Railway, etc). En local no se tocan:
# - PORT: lo inyecta la plataforma sola, pisa a ACTIVITY_PORT si está.
# - YTDLP_PATH: ruta al binario de yt-dlp si no está en ~/.local/bin/yt-dlp (el Dockerfile ya lo setea).
# - YTDLP_COOKIES: contenido completo de cookies.txt pegado acá, para no depender de un archivo local.
# PORT=
# YTDLP_PATH=
# YTDLP_COOKIES=
